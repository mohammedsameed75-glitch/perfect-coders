a = float(input("Enter first number: "))
op = input("Enter operator (+, -, x, /): ")
b = float(input("Enter second number: "))
match op:
    case "+":
        print(a + b)
    case "-":
        print(a - b)
    case "x":
        print(a * b)
    case "/":
        print(a / b)
    case _:
        print("Invalid operator")